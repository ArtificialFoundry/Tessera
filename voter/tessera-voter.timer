# tessera-voter.timer — run voter agent every 30 seconds
#
# Install:
#   sudo systemctl enable --now tessera-voter.timer
#   systemctl list-timers tessera-voter.timer

[Unit]
Description=Tessera voter agent timer (every 30s)

[Timer]
OnBootSec=10s
OnUnitActiveSec=30s
AccuracySec=1s

[Install]
WantedBy=timers.target
